# Clerk authentication (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# PostgreSQL / Prisma (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public

# Order notification email via Resend (required to send notifications; otherwise notifications are skipped)
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Store Orders <orders@example.com>

# Optional development recipient override for order notifications
RESEND_TEST_RECIPIENT=developer@example.com
