generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Store {
  id                  String      @id @default(uuid())
  name                String
  userId              String
  logoUrl             String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  billboards          Billboard[] @relation("StoreToBillboard")
  homepageBillboardId String?
  homepageBillboard   Billboard?  @relation("StoreHomepageBillboard", fields: [homepageBillboardId], references: [id])
  categories          Category[]  @relation("StoreToCategory")
  colors              Color[]     @relation("StoreToColor")
  orders              Order[]     @relation("StoreToOrder")
  products            Product[]   @relation("StoreToProduct")
  sizes               Size[]      @relation("StoreToSize")
  billingProfile      StoreBillingProfile?

  @@index([homepageBillboardId])
}

model StoreBillingProfile {
  id                       String   @id @default(uuid())
  storeId                  String   @unique
  legalName                String?
  billingContactName       String?
  billingEmail             String?
  billingPhone             String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  postalCode               String?
  country                  String?
  taxNumber                String?
  companyRegistrationNumber String?
  currency                 String   @default("PKR")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Billboard {
  id                String     @id @default(uuid())
  storeId           String
  label             String
  imageUrl          String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  store             Store      @relation("StoreToBillboard", fields: [storeId], references: [id])
  homepageForStores Store[]    @relation("StoreHomepageBillboard")
  categories        Category[]

  @@index([storeId])
}

model Category {
  id          String     @id @default(uuid())
  storeId     String
  billboardId String?
  parentId    String?
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  billboard   Billboard? @relation(fields: [billboardId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store       Store      @relation("StoreToCategory", fields: [storeId], references: [id])
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("CategoryToProduct")

  @@index([storeId])
  @@index([billboardId])
  @@index([parentId])
}

model Product {
  id         String      @id @default(uuid())
  storeId    String
  categoryId String
  name       String
  price      Decimal
  quantity   Int         @default(0)
  isFeatured Boolean     @default(false)
  isArchived Boolean     @default(false)
  sizeId     String
  colorId    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  images     Image[]
  orderItems OrderItem[]
  category   Category    @relation("CategoryToProduct", fields: [categoryId], references: [id])
  color      Color       @relation(fields: [colorId], references: [id])
  size       Size        @relation(fields: [sizeId], references: [id])
  store      Store       @relation("StoreToProduct", fields: [storeId], references: [id])

  @@index([storeId])
  @@index([categoryId])
  @@index([sizeId])
  @@index([colorId])
}

model Order {
  id         String      @id @default(uuid())
  storeId    String
  store      Store       @relation("StoreToOrder", fields: [storeId], references: [id])
  orderItems OrderItem[]

  status        OrderStatus   @default(DRAFT)
  paymentMethod PaymentMethod @default(COD)
  trackingId    String        @unique

  // Nullable for legacy orders created before immutable snapshots existed.
  subtotal      Decimal?
  total         Decimal?
  currency      String?

  // payment flags
  isPaid Boolean @default(false)

  // customer
  customerName String @default("")
  email        String @default("")
  phone        String @default("")

  // shipping (structured)
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  postalCode   String @default("")
  country      String @default("PK")

  // notes
  customerNotes String @default("")

  // legacy field (keep for backwards compatibility)
  // You can remove this later after you migrate UI fully.
  address String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([trackingId])
  @@index([status])
  @@index([paymentMethod])
  @@index([isPaid])
  @@index([city])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  // Captured from Product.price at order creation; null on legacy rows.
  unitPrice Decimal?
  lineTotal Decimal?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Size {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  store     Store     @relation("StoreToSize", fields: [storeId], references: [id])

  @@index([storeId])
}

model Color {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation("StoreToColor", fields: [storeId], references: [id])
  products  Product[]

  @@index([storeId])
}

model Image {
  id        String   @id @default(uuid())
  productId String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  STRIPE
  COD
}
